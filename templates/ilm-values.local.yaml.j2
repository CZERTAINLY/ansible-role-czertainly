# {{ ansible_managed }}
---
global:
{% if docker.username is defined and docker.password is defined %}
  image:
     pullSecrets:
      - {{ docker.secret }}
  imagePullSecrets:
    - name: "{{ docker.secret }}"
{% endif %}
  database:
    host: "{{ ansible_default_ipv4.address }}"
{% if postgres.database is defined %}
    name: "{{ postgres.database }}"
{% endif %}
{% if postgres.username is defined %}
    username: "{{ postgres.username }}"
{% endif %}
{% if postgres.password is defined %}
    password: "{{ postgres.password }}"
{% endif %}
{% if proxy is defined %}
{% if proxy.http is defined %}
  httpProxy: {{ proxy.http }}
{% endif %}
{% if proxy.http is defined %}
  httpsProxy: {{ proxy.https }}
{% endif %}
{% if proxy.dont_use_for is defined %}
  noProxy: "{{ proxy.dont_use_for | join(', ') }}"
{% endif %}
{% endif %}
{% if trustedCA_file is defined %}
  trusted:
    certificates: {{ lookup('ansible.builtin.file', trustedCA_file) | to_nice_json(indent=0) }}
{% elif (default_values.global.trusted.certificates is defined) and (default_values.global.trusted.certificates | length > 0) %}
  trusted:
    certificates: {{ default_values.global.trusted.certificates | to_nice_json(indent=0) }}
{% elif (default_values.trusted.certificates is defined) and (default_values.trusted.certificates | length > 0) %}
  trusted:
    certificates: {{ default_values.trusted.certificates | to_nice_json(indent=0) }}
{% endif %}
  keycloak:
{% if (ilm is defined) and (ilm.keycloak is defined) and ilm.keycloak %}
    enabled: true
    # client secret must be set if keycloak is enabled
    clientSecret: "{{ keycloak_client_secret }}"
{% else %}
    enabled: false
{% endif %}
  utils:
{% if (ilm is defined) and (ilm.utilsService is defined) and ilm.utilsService %}
    enabled: true
{% else %}
    enabled: false
{% endif %}

  hostName: "{{ ansible_fqdn }}"
  admin:
    username: "admin"
    password: "newgenerationtrustcare"
    name: "admin"
    surname: "admin"
    email: "admin@ilm.local"

# this is needed only for KeyCloak
{% if (ilm is defined) and (ilm.keycloak is defined) and ilm.keycloak %}
apiGateway:
  hostAliases:
    resolveInternalKeycloak: true
  trustedIps: "0.0.0.0/0,::/0"
{% endif %}

hostName: "{{ ansible_fqdn }}"
ingress:
  enabled: true
  certificate:
{% if (ingress is defined) and (ingress.certificate_file is defined) and (ingress.private_key_file is defined) %}
    source: external
{% else %}
    source: internal
{% endif %}

registerConnectors: true

commonCredentialProvider:
{% if (ilm is defined) and (ilm.commonCredentialProvider is defined) and ilm.commonCredentialProvider %}
  enabled: true
{% else %}
  enabled: false
{% endif %}

ejbcaNgConnector:
{% if (ilm is defined) and (ilm.ejbcaNgConnector is defined) and ilm.ejbcaNgConnector %}
  enabled: true
{% else %}
  enabled: false
{% endif %}

pyAdcsConnector:
{% if (ilm is defined) and (ilm.pymsAdcsConnector is defined) and ilm.pymsAdcsConnector %}
  enabled: true
{% else %}
  enabled: false
{% endif %}

hashicorpVaultConnector:
{% if (ilm is defined) and (ilm.hashicorpVaultConnector is defined) and ilm.hashicorpVaultConnector %}
  enabled: true
{% else %}
  enabled: false
{% endif %}

x509ComplianceProvider:
{% if (ilm is defined) and (ilm.x509ComplianceProvider is defined) and ilm.x509ComplianceProvider %}
  enabled: true
{% else %}
  enabled: false
{% endif %}

cryptosenseDiscoveryProvider:
{% if (ilm is defined) and (ilm.cryptosenseDiscoveryProvider is defined) and ilm.cryptosenseDiscoveryProvider %}
  enabled: true
{% else %}
  enabled: false
{% endif %}

ctLogsDiscoveryProvider:
{% if (ilm is defined) and (ilm.ctLogsDiscoveryProvider is defined) and ilm.ctLogsDiscoveryProvider %}
  enabled: true
{% else %}
  enabled: false
{% endif %}

networkDiscoveryProvider:
{% if (ilm is defined) and (ilm.networkDiscoveryProvider is defined) and ilm.networkDiscoveryProvider %}
  enabled: true
{% else %}
  enabled: false
{% endif %}

keystoreEntityProvider:
{% if (ilm is defined) and (ilm.keystoreEntityProvider is defined) and ilm.keystoreEntityProvider %}
  enabled: true
{% else %}
  enabled: false
{% endif %}

softwareCryptographyProvider:
{% if (ilm is defined) and (ilm.softwareCryptographyProvider is defined) and ilm.softwareCryptographyProvider %}
  enabled: true
{% else %}
  enabled: false
{% endif %}

emailNotificationProvider:
{% if (ilm is defined) and (ilm.emailProvider is defined) and ilm.emailProvider %}
  enabled: true
  smtp:
{% if smtp_host is defined %}
    host: {{ smtp_host }}
{% endif %}
{% if smtp_port is defined %}
    port: {{ smtp_port }}
{% endif %}
{% if smtp_tls is defined %}
    tls: {{ smtp_tls }}
{% endif %}
{% if smtp_username is defined %}
    auth: true
    username: {{ smtp_username }}
{% if smtp_password  is defined %}
    password: {{ smtp_password }}
{% endif %}
{% else %}
    auth: false
{% endif %}
{% else %}
  enabled: false
{% endif %}

webhookNotificationProvider:
{% if (ilm is defined) and (ilm.webhookNotificationProvider is defined) and ilm.webhookNotificationProvider %}
  enabled: true
{% else %}
  enabled: false
{% endif %}