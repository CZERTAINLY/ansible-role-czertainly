# {{ ansible_managed }}
#
# Everything below that reaches the database gets an init container waiting
# for it. Helm starts all pods at once, while pg-bouncer - which every
# component connects through - needs about as long as its image pull to come
# up, and the components that talk to the database while starting die in the
# meantime and are restarted until it answers.
#
# The image and the endpoint are taken from the defaults of the chart itself,
# so that neither goes stale when the chart moves them. The chart uses the
# same image and the same 'nc' loop for its own waits, see the
# wait-for-auth-service of core.
{% set curl_image = default_values.curl.image %}
{% set wait_image = curl_image.registry ~ '/' ~ curl_image.repository ~ '/' ~ curl_image.name ~ ':' ~ curl_image.tag %}
{% if default_values.global.database.pgBouncer.enabled | default(true) %}
{% set wait_host = default_values.global.database.pgBouncer.host %}
{% set wait_port = default_values.global.database.pgBouncer.port %}
{% else %}
{% set wait_host = ansible_default_ipv4.address %}
{% set wait_port = 5432 %}
{% endif %}
#
# The macro renders at the left margin, a component nests it with indent(2).
{% macro wait_for_database() -%}
initContainers:
  - name: wait-for-database
    image: "{{ wait_image }}"
    imagePullPolicy: IfNotPresent
    securityContext:
      readOnlyRootFilesystem: true
      runAsNonRoot: true
    command:
      - /bin/sh
      - -c
      - |
        deadline=$(( $(date +%s) + {{ ilm_db_wait_seconds }} ))
        while ! nc -z -w 2 {{ wait_host }} {{ wait_port }}; do
          if [ "$(date +%s)" -ge "$deadline" ]; then
            echo "Timed out after {{ ilm_db_wait_seconds }}s waiting for {{ wait_host }}:{{ wait_port }}"
            exit 1
          fi
          sleep 1
        done
        echo "database seems to be started"
{%- endmacro %}
---
# core is the deployment of the chart itself, so its init containers are read
# from the values root.
{{ wait_for_database() }}

global:
{% if docker.username is defined and docker.password is defined %}
  image:
     pullSecrets:
      - {{ docker.secret }}
  imagePullSecrets:
    - name: "{{ docker.secret }}"
{% endif %}
  database:
    host: "{{ ansible_default_ipv4.address }}"
{% if postgres.database is defined %}
    name: "{{ postgres.database }}"
{% endif %}
{% if postgres.username is defined %}
    username: "{{ postgres.username }}"
{% endif %}
{% if postgres.password is defined %}
    password: "{{ postgres.password }}"
{% endif %}
{% if proxy is defined %}
{% if proxy.http is defined %}
  httpProxy: {{ proxy.http }}
{% endif %}
{% if proxy.https is defined %}
  httpsProxy: {{ proxy.https }}
{% endif %}
{% if proxy.dont_use_for is defined %}
  noProxy: "{{ proxy.dont_use_for | join(', ') }}"
{% endif %}
{% endif %}
{% if trustedCA_file is defined %}
  trusted:
    certificates: {{ lookup('ansible.builtin.file', trustedCA_file) | to_nice_json(indent=0) }}
{% elif (default_values.global.trusted.certificates is defined) and (default_values.global.trusted.certificates | length > 0) %}
  trusted:
    certificates: {{ default_values.global.trusted.certificates | to_nice_json(indent=0) }}
{% elif (default_values.trusted.certificates is defined) and (default_values.trusted.certificates | length > 0) %}
  trusted:
    certificates: {{ default_values.trusted.certificates | to_nice_json(indent=0) }}
{% endif %}
  keycloak:
{% if (ilm is defined) and (ilm.keycloak is defined) and ilm.keycloak %}
    enabled: true
    # client secret must be set if keycloak is enabled
    clientSecret: "{{ keycloak_client_secret }}"
{% else %}
    enabled: false
{% endif %}
  utils:
{% if (ilm is defined) and (ilm.utilsService is defined) and ilm.utilsService %}
    enabled: true
{% else %}
    enabled: false
{% endif %}

  hostName: "{{ ansible_fqdn }}"
  admin:
    username: "admin"
    password: "newgenerationtrustcare"
    name: "admin"
    surname: "admin"
    email: "admin@ilm.local"

# this is needed only for KeyCloak
{% if (ilm is defined) and (ilm.keycloak is defined) and ilm.keycloak %}
apiGateway:
  hostAliases:
    resolveInternalKeycloak: true
  trustedIps: "0.0.0.0/0,::/0"
{% endif %}

hostName: "{{ ansible_fqdn }}"
ingress:
  enabled: true
  class: {{ ilm_ingress_class }}
  certificate:
{% if (ingress is defined) and (ingress.certificate_file is defined) and (ingress.private_key_file is defined) %}
    source: external
{% else %}
    source: internal
{% endif %}
{% if ilm_ingress_class == 'traefik' %}
  # The chart annotates the Ingress for ingress-nginx, traefik ignores all of
  # that and is configured through these instead. The names are
  # "<namespace>-<resource>@kubernetescrd", the resources themselves are in
  # traefik-ingress.yaml. cert-header-encode has to come after
  # pass-client-cert, it encodes the header the other one writes.
  annotations:
    traefik.ingress.kubernetes.io/router.tls: "true"
    traefik.ingress.kubernetes.io/router.tls.options: "{{ app_namespace }}-ilm-mtls@kubernetescrd"
    traefik.ingress.kubernetes.io/router.middlewares: "{{ app_namespace }}-pass-client-cert@kubernetescrd,{{ app_namespace }}-cert-header-encode@kubernetescrd"

# Which header core reads the client certificate from. The chart default is
# the ssl-client-cert of ingress-nginx, traefik's passTLSClientCert writes
# this one.
auth:
  header:
    certificate: "X-Forwarded-Tls-Client-Cert"
{% endif %}

